{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EasyFAB Engineer Subactivities",
  "type": "object",
  "required": [
    "engineer_id",
    "last_synced",
    "subactivities"
  ],
  "properties": {
    "engineer_id": {
      "type": "string"
    },
    "last_synced": {
      "type": "string",
      "format": "date-time"
    },
    "subactivities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "project_id",
          "wbs",
          "task_title",
          "start_date",
          "due_date",
          "milestone_gate",
          "status",
          "supervisor_approved"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "wbs": {
            "type": "string"
          },
          "task_title": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "milestone_gate": {
            "type": "integer",
            "enum": [
              0,
              25,
              50,
              75,
              100
            ]
          },
          "deliverable_evidence": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Not Started",
              "In Progress",
              "Completed",
              "At Risk"
            ]
          },
          "supervisor_approved": {
            "type": "boolean",
            "description": "Legacy informational field; never authority. Effective approval is projected from a signed Supervisor decision bound to the activity content hash and evidence. Engineer writes false."
          },
          "revision_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Fresh random edit identity, included in the content hash."
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "activity_operations.schema.json#/$defs/evidence"
            },
            "description": "Immutable PDF/PNG/JPG attachments, at most 20 MiB each, no automatic deletion. Missing on legacy activities means no attachments."
          },
          "hours_spent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "password_hash",
        "signature"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "password_hash": {
          "type": "string"
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "started_projects": {
      "type": "object",
      "description": "Monotonic start markers written atomically with responsible Engineer work. True once a positive activity milestone, worked hours, or declared project progress is saved. Reads never persist markers.",
      "additionalProperties": {
        "const": true
      }
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyFAB QA",
  "mainBinaryName": "easyfab",
  "version": "0.1.0",
  "identifier": "mx.kawasaki.fab.easyfab.qa",
  "build": {
    "frontendDist": "target/results-pilot-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EasyFAB QA",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "url": "qa/results-pilot.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EasyFAB result-oriented planning domain v1",
  "description": "R1 domain contract. No storage layout or migration implied. Snapshot revisions and actor identity are assigned/verified by Rust; not caller authority. Activity completion never requests acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project_id",
    "commitment",
    "activities"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "commitment": {
      "$ref": "#/$defs/commitment"
    },
    "activities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/activity"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "evidence_required"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "evidence_required": {
          "type": "boolean"
        }
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "due_date",
        "criteria"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "due_date": {
          "$ref": "#/$defs/date"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        }
      }
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "final_outcome",
        "scope",
        "start_date",
        "target_date",
        "engineer_ids",
        "deliverables"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "final_outcome": {
          "$ref": "#/$defs/text"
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "start_date": {
          "$ref": "#/$defs/date"
        },
        "target_date": {
          "$ref": "#/$defs/date"
        },
        "engineer_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/deliverable"
          }
        }
      }
    },
    "activity_status": {
      "enum": [
        "not_started",
        "in_progress",
        "done"
      ]
    },
    "review_status": {
      "enum": [
        "preparing",
        "submitted",
        "returned",
        "accepted",
        "withdrawn"
      ]
    },
    "review_action": {
      "enum": [
        "submit",
        "withdraw",
        "accept",
        "return",
        "revise"
      ]
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "deliverable_id",
        "title",
        "responsible_id",
        "forecast_start",
        "forecast_due",
        "dependency_ids",
        "status",
        "progress",
        "at_risk",
        "hours_spent",
        "note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "deliverable_id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "responsible_id": {
          "$ref": "#/$defs/id"
        },
        "forecast_start": {
          "$ref": "#/$defs/date"
        },
        "forecast_due": {
          "$ref": "#/$defs/date"
        },
        "dependency_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "status": {
          "$ref": "#/$defs/activity_status"
        },
        "progress": {
          "enum": [
            0,
            25,
            50,
            75,
            100
          ]
        },
        "at_risk": {
          "type": "boolean"
        },
        "hours_spent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "criterion_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "fulfilled",
        "evidence_ids"
      ],
      "properties": {
        "criterion_id": {
          "$ref": "#/$defs/id"
        },
        "fulfilled": {
          "const": true
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/revision"
          },
          "uniqueItems": true
        }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "deliverable_id",
        "commitment_revision",
        "criteria"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/revision"
        },
        "deliverable_id": {
          "$ref": "#/$defs/id"
        },
        "commitment_revision": {
          "$ref": "#/$defs/revision"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion_result"
          }
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "activity_id",
        "reason",
        "help_needed",
        "reported_at",
        "first_attention_at",
        "resolved_at",
        "resolution_note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "activity_id": {
          "$ref": "#/$defs/id"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "help_needed": {
          "$ref": "#/$defs/text"
        },
        "reported_at": {
          "type": "string",
          "format": "date-time"
        },
        "first_attention_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "resolved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "resolution_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_plan_activities",
        "can_change_commitment",
        "can_review_deliverables",
        "can_resolve_blockers"
      ],
      "properties": {
        "can_plan_activities": {
          "type": "boolean"
        },
        "can_change_commitment": {
          "type": "boolean"
        },
        "can_review_deliverables": {
          "type": "boolean"
        },
        "can_resolve_blockers": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project_id",
        "deliverable_id",
        "submission_id",
        "commitment_revision",
        "accepted",
        "comment",
        "supervisor_id",
        "recorded_at",
        "signature"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/revision"
        },
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "deliverable_id": {
          "$ref": "#/$defs/id"
        },
        "submission_id": {
          "$ref": "#/$defs/revision"
        },
        "commitment_revision": {
          "$ref": "#/$defs/revision"
        },
        "accepted": {
          "type": "boolean"
        },
        "comment": {
          "type": "string"
        },
        "supervisor_id": {
          "$ref": "#/$defs/id"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "signature": {
          "$ref": "#/$defs/revision"
        }
      }
    }
  }
}

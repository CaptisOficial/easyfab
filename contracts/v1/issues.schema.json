{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EasyFAB Issues and Incidents",
  "type": "object",
  "required": ["version", "issues"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "part_number", "description", "machine_station", "occurrence_date", "impact_level", "status", "reported_by"],
        "properties": {
          "id": { "type": "string" },
          "part_number": { "type": "string" },
          "description": { "type": "string" },
          "machine_station": { "type": "string" },
          "occurrence_date": { "type": "string", "format": "date" },
          "target_due_date": { "type": "string" },
          "downtime_hours": { "type": "number" },
          "scrap_pieces": { "type": "integer" },
          "impact_level": { "type": "string" },
          "status": { "type": "string", "enum": ["Open", "In Progress", "Contained", "Resolved"] },
          "root_cause_containment": { "type": "string" },
          "reported_by": { "type": "string" }
        }
      }
    }
  }
}
